<Window x:Class="ITTicketSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IT Destek Talep Sistemi" Height="550" Width="1100">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- SOL: Liste -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Talepler" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid x:Name="TicketsGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding Tickets}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                      Command="{Binding EditTicketCommand}"
                      CommandParameter="{Binding SelectedItem, ElementName=TicketsGrid}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="150"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Category.Name}" Width="100"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding Status.Name}" Width="90"/>
                    <DataGridTextColumn Header="Atanan" Binding="{Binding Employee.Name}" Width="130"/>
                    <DataGridTextColumn Header="Öncelik" Binding="{Binding Priority}" Width="80"/>
                    <DataGridTextColumn Header="Oluşturulma" Binding="{Binding CreatedDate}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- SAĞ: Form -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding FormHeader}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Başlık"/>
            <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="Açıklama"/>
            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                     Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

            <TextBlock Text="Kategori"/>
            <ComboBox ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategory}"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Atanacak Çalışan (opsiyonel)"/>
            <ComboBox ItemsSource="{Binding Employees}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedEmployee}"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Durum"/>
            <ComboBox ItemsSource="{Binding Statuses}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedStatus}"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Öncelik"/>
            <ComboBox SelectedValue="{Binding NewPriority}"
                      SelectedValuePath="Content"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Düşük"/>
                <ComboBoxItem Content="Normal"/>
                <ComboBoxItem Content="Yüksek"/>
            </ComboBox>

            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Padding="0,8" Margin="0,0,0,8"/>
            <Button Content="Yeni Talep" Command="{Binding NewTicketCommand}" Padding="0,8" Margin="0,0,0,8"/>
            <Button Content="Sil" Command="{Binding DeleteCommand}" Padding="0,8" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>